<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tech.kayys.numou</groupId>
        <artifactId>numou-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath/>
    </parent>
    <groupId>tech.kayys.numou</groupId>
    <artifactId>numou-security</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Numou Security</name>
    <description>Reusable security, contextual authorization, audit, vault and secret-management capability.</description>
    <modules>
        <module>bom</module>
        <module>security-domain</module>
        <module>security-spi</module>
        <module>security-application</module>
        <module>security-adapter</module>
        <module>social-graph-adapter</module>
        <module>security-vault-domain</module>
        <module>security-vault-spi</module>
        <module>security-vault-application</module>
        <module>security-vault-postgres</module>
        <module>security-vault-crypto</module>
        <module>vault-secret</module>
        <module>vault-secret-cloud</module>
    </modules>
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/andalus-ai/numu</url>
        </repository>
    </repositories>
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tech.kayys.numou</groupId>
                <artifactId>numou-bom</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages - Numou Security</name>
            <url>https://maven.pkg.github.com/andalus-ai/numou-security</url>
        </repository>
    </distributionManagement>
</project>
